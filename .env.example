# ============================================================================
# Tronpay-backend — environment template
# Copy to `.env` and fill in your OWN values. Do NOT commit the real .env.
# ============================================================================

# ---- Service ----
NODE_ENV=production            # use "production" when deployed
PORT=3002

# ---- Database ----
# Your own MongoDB (Atlas or self-hosted).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=Tronpay

# ---- Auth ----
JWT_SECRET=                    # a strong random string
SESSION_EXPIRES_IN_MINUTES=60  # session validity duration in minutes
JWT_EXPIRES_IN=60m

# ---- Deposit wallets ----
# Path to a JS file exporting an array of TRON addresses you control.
# This file is gitignored — you must create it yourself (see data/wallets.js).
WALLET_SEED_FILE=./data/wallets.js

# Deployed URL of THIS service (used for deposit ingest websocket).
DEPOSIT_INGEST_WS_URL=https://<your-tronpay-host>

# ---- Email / SMTP (OTP + notifications) ----
# For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TronPay <you@example.com>

# ---- Payout bridge (this service <-> payout-bridge) ----
PAYOUT_BRIDGE_URL=http://localhost:3005   # deployed bridge URL in prod
PAYOUT_BRIDGE_API_KEY=                     # MUST equal bridge INBOUND_API_KEY
PAYOUT_BRIDGE_CALLBACK_SECRET=             # MUST equal bridge CALLBACK_SIGNING_SECRET

# ---- Laaffic SMS (OTP) ----
# Note: whitelist your server's outbound IP in the Laaffic dashboard or SMS fails.
LAAFFIC_API_KEY=
LAAFFIC_API_SECRET=
LAAFFIC_APP_ID=
LAAFFIC_SENDER_ID=            # optional — branded sender id

# ---- Wallet key sharding (private keys for deposit wallets) ----
MONGODB_URI_SHARD_1=mongodb+srv://<user>:<password>@<cluster>/tronpay_shard1
MONGODB_URI_SHARD_2=mongodb+srv://<user>:<password>@<cluster>/tronpay_shard2
WALLET_ENCRYPTION_KEY=        # 64 hex chars (32 bytes) — NEVER commit the real value

# ---- USDT auto-sweep (custodial deposit wallets -> admin hot wallet) ----
SWEEP_ENABLED=false
ADMIN_WALLET_ADDRESS=         # TRC-20 address that receives swept USDT
ADMIN_WALLET_PRIVATE_KEY=       # hex private key for admin hot wallet (gas + receives USDT) — NEVER commit
TRON_FULL_NODE=https://api.trongrid.io
TRON_API_KEY=                   # optional TronGrid API key
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZYs4H5z8J4m9X6nF3
SWEEP_MIN_USDT=1
SWEEP_TRX_FUND_AMOUNT=20
SWEEP_TRX_MIN_BALANCE=5
SWEEP_MAX_ATTEMPTS=5
