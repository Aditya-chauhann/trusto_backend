{
  "name": "tronpay-backend",
  "version": "0.0.1",
  "description": "TrustO backend",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"try{fs.rmSync('dist',{recursive:true,force:true})}catch(e){} try{fs.unlinkSync('tsconfig.tsbuildinfo')}catch(e){}\"",
    "build": "nest build",
    "start": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.js",
    "start:dev": "nodemon -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.js",
    "start:prod": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.js",
    "seed:wallets": "ts-node -r tsconfig-paths/register src/scripts/seed-wallets.ts",
    "verify:sweep": "ts-node -r tsconfig-paths/register src/scripts/verify-sweep-config.ts",
    "check:sweep-jobs": "ts-node -r tsconfig-paths/register src/scripts/check-sweep-jobs.ts",
    "sweep:backfill": "ts-node -r tsconfig-paths/register src/scripts/backfill-sweep-jobs.ts",
    "sweep:enqueue-deposits": "ts-node -r tsconfig-paths/register src/scripts/enqueue-all-deposits.ts"
  },
  "dependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/websockets": "^10.4.22",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.0",
    "mongoose": "^8.2.0",
    "nodemailer": "^8.0.7",
    "nodemon": "^3.1.14",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tronweb": "^6.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "ts-loader": "^9.5.1"
  }
}